pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include mouse.lua
#include player.lua
#include scenario.lua
#include speech.lua


-- init ------------------------


function _init()
	init_mouse()
	init_player()
	init_scenario()
	init_speech()
	say("hello world")
end


-- update ----------------------


function _update60()
	update_mouse()
	update_player()
	update_speech()
end


function any_input()
	return btn(4) or btn(5) or mouse.pressed
end


-- draw ------------------------


function _draw()
	camera(player.x - 64, player.y - 64)
	draw_bg()
	draw_characters()
	draw_player()

	camera(0, 0)
	draw_speech()
	-- draw_mouse()
end


function draw_bg()
	cls(0)
	map(0, 0, 0, 0, 128, 128)
end


function strobe(period, offset)
	return (t() - (offset or 0) + period) % (period * 2) < period
end


